OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_TIMEOUT=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=30

CLU_PROVIDER=gemini
NLG_ENABLED=false
DEBUG_CONVERSATION=true

# Relative paths are resolved from the repository root.
ROOM_REGISTRY_PATH=data/office_rooms.json
ROOM_ALIASES_PATH=data/office_room_aliases.json
# Standalone HTTP API (one process; .env is not automatically loaded)
API_HOST=127.0.0.1
API_PORT=8000
# Render supplies RENDER=true and PORT. On Render PORT overrides API_PORT,
# API_HOST must be 0.0.0.0, and the factory validates auth/provider/map config.
# Required when API_HOST is not loopback. Never commit the real token.
# API_ACCESS_TOKEN=replace-with-a-random-shared-secret

# Remote smoke client only (set real values locally; never commit secrets).
# NLP_API_URL=https://your-actual-service.onrender.com
# NLP_API_TOKEN=the-server-API_ACCESS_TOKEN

# Optional PostgreSQL operations backend. Install requirements-operations.txt,
# migrate/provision explicitly before enabling. Never commit a real connection URL.
# DATABASE_URL=postgresql://user:password@host:5432/office_robot
# OPERATOR_TOKEN=distinct-random-secret-at-least-24-characters
# ROBOT_GATEWAY_TOKEN=another-distinct-random-secret-at-least-24-characters
# Isolated integration tests only (never a production database):
# OFFICE_ROBOT_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/office_robot_test
